# Local env for ServiceOP public website

# Laravel API base URL (no trailing slash)
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: force brand domain when browsing via localhost
# BRAND_DOMAIN=acuteradrywall.ca

# Talk (live STT): leave unset/false in production until iPhone Safari is verified.
# NEXT_PUBLIC_ENABLE_INTAKE_TALK=true
#
# Safe per-visit test (no global flag): open any public page with ?enableTalk=1
# e.g. https://acuteradrywall.ca/quote?enableTalk=1
# That stores a tab sessionStorage flag only — other visitors are unaffected.
